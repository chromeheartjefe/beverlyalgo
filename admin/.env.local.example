# Copy to admin/.env.local (git-ignored) and fill in. Never commit real values.

# Read-only login (admin/sql/roles.sql). Your DATABASE_URL with the user and
# password swapped for entrix_admin_read.
ADMIN_DATABASE_URL=postgresql://entrix_admin_read:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Write login for the safe actions only (entrix_admin_write)
ADMIN_WRITE_DATABASE_URL=postgresql://entrix_admin_write:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Stripe restricted key, READ permissions only (see README)
STRIPE_ADMIN_KEY=rk_live_...

# For "Resend verification": same values as the site uses
RESEND_API_KEY=re_...
EMAIL_FROM=EntrixAlgo <noreply@entrixalgo.com>
# Must be the live site, the email link is built from it
AUTH_URL=https://entrixalgo.com

# Optional, same meaning as on the site (default 50)
# AI_MONTHLY_BUDGET_USD=50
